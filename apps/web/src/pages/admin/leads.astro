---
import Admin from '../../layouts/Admin.astro';
import Icon from '../../components/Icon.astro';
import { LEADS, STAGES } from '../../data/demo';
const fmt = new Intl.NumberFormat('es-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
---
<Admin title="Gestor de leads" active="leads">
  <section class="panel">
    <div class="panel-head">
      <h2>{LEADS.length} leads</h2>
      <div class="toolbar" role="search">
        <input type="search" placeholder="Buscar por nombre, teléfono o ID" aria-label="Buscar leads" data-q />
        <select aria-label="Filtrar por etapa" data-stage>
          <option value="">Todas las etapas</option>
          {STAGES.map((s) => <option value={s.key}>{s.label}</option>)}
        </select>
        <select aria-label="Filtrar por objetivo" data-goal>
          <option value="">Todos los objetivos</option>
          {['Compra', 'Refinanciación', 'Comercial', 'Inversión'].map((g) => <option value={g}>{g}</option>)}
        </select>
        <button class="btn sm" type="button" data-export><Icon name="file-text" size={16} />Exportar CSV</button>
      </div>
    </div>
    <div class="table-scroll">
      <table class="leads">
        <thead><tr><th>ID</th><th>Lead</th><th>Objetivo</th><th>Condado</th><th>Crédito</th><th>Origen</th><th>Etapa</th><th class="num">Monto</th><th>Próximo paso</th><th><span class="visually-hidden">Acciones</span></th></tr></thead>
        <tbody data-rows>
          {LEADS.map((l) => (
            <tr data-row data-stage={l.stage} data-goal={l.goal} data-text={`${l.id} ${l.name} ${l.phone}`.toLowerCase()}>
              <td>{l.id}</td>
              <td class="who"><strong>{l.name}</strong><span>{l.phone} · {l.lang.toUpperCase()}</span></td>
              <td>{l.goal}</td>
              <td>{l.county}</td>
              <td>{l.score}</td>
              <td>{l.source}</td>
              <td><span class={`pill st-${l.stage}`}>{STAGES.find((s) => s.key === l.stage)!.label}</span></td>
              <td class="num">{fmt.format(l.amount)}</td>
              <td>{l.next}</td>
              <td><a class="icon-btn" href={`/admin/chat/`} aria-label={`Abrir chat con ${l.name}`}><Icon name="message-circle" size={18} /></a></td>
            </tr>
          ))}
          <tr class="empty-row" hidden data-empty><td colspan="10">No hay leads con esos filtros.</td></tr>
        </tbody>
      </table>
    </div>
    <p class="small" data-toast hidden>Demo: la exportación no descarga archivos.</p>
  </section>

<script>
  const q = document.querySelector<HTMLInputElement>('[data-q]')!;
  const st = document.querySelector<HTMLSelectElement>('[data-stage]')!;
  const goal = document.querySelector<HTMLSelectElement>('[data-goal]')!;
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('[data-row]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const apply = () => {
    const t = q.value.trim().toLowerCase();
    let shown = 0;
    rows.forEach((r) => {
      const ok = (!t || r.dataset.text!.includes(t)) && (!st.value || r.dataset.stage === st.value) && (!goal.value || r.dataset.goal === goal.value);
      r.hidden = !ok;
      if (ok) shown++;
    });
    empty.hidden = shown > 0;
  };
  [q, st, goal].forEach((el) => el.addEventListener('input', apply));
  document.querySelector('[data-export]')!.addEventListener('click', () => { document.querySelector<HTMLElement>('[data-toast]')!.hidden = false; });
</script>

<section class="panel" data-live hidden data-api={import.meta.env.PUBLIC_API_URL || 'https://loanpro365-api.francisco-buenano.workers.dev'}>
  <div class="panel-head">
    <h2 data-live-count>Leads reales</h2>
    <div class="toolbar"><input type="search" placeholder="Buscar nombre, teléfono o correo" aria-label="Buscar leads reales" data-live-q /><button class="btn sm ghost" type="button" data-live-out>Salir</button></div>
  </div>
  <div class="table-scroll">
    <table class="leads">
      <thead><tr><th>Fecha</th><th>Lead</th><th>Origen</th><th>Idioma</th><th>Datos</th><th>Etapa</th></tr></thead>
      <tbody data-live-rows></tbody>
    </table>
  </div>
  <p class="small" data-live-msg role="status"></p>
</section>

<script>
  const key = sessionStorage.getItem('lp365-admin');
  const live = document.querySelector<HTMLElement>('[data-live]')!;
  if (key) {
    document.querySelectorAll<HTMLElement>('.panel:not([data-live]), .adm-demo').forEach((el) => (el.hidden = true));
    live.hidden = false;
    const api = live.dataset.api!;
    const body = live.querySelector<HTMLElement>('[data-live-rows]')!;
    const msg = live.querySelector<HTMLElement>('[data-live-msg]')!;
    const qIn = live.querySelector<HTMLInputElement>('[data-live-q]')!;
    const h = { authorization: `Bearer ${key}` };
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const LABEL: Record<string, string> = { nuevo: 'Nuevo', contactado: 'Contactado', documentos: 'Documentos', enviado: 'Enviado al prestamista', aprobado: 'Aprobado', cerrado: 'Cerrado', perdido: 'Perdido' };
    const load = async () => {
      msg.textContent = 'Cargando…';
      const r = await fetch(`${api}/v1/admin/leads?q=${encodeURIComponent(qIn.value)}`, { headers: h });
      if (r.status === 401) { sessionStorage.removeItem('lp365-admin'); location.href = '/admin/login/'; return; }
      const { leads, stages } = await r.json();
      live.querySelector('[data-live-count]')!.textContent = `${leads.length} leads reales`;
      body.innerHTML = leads.map((l: any) => {
        let p: any = {}; try { p = JSON.parse(l.payload_json) ?? {}; } catch {}
        const data = Object.entries(p).slice(0, 6).map(([k, v]) => `${esc(k)}: ${esc(v)}`).join(' · ');
        return `<tr><td>${esc(new Date(l.created_at).toLocaleString('es-US'))}</td>
          <td class="who"><strong>${esc(l.name)}</strong><span>${esc(l.phone)} ${l.email ? '· ' + esc(l.email) : ''}</span></td>
          <td>${esc(l.source_tool ?? '—')}</td><td>${esc(l.locale).toUpperCase()}</td><td class="small">${data}</td>
          <td><select aria-label="Etapa de ${esc(l.name)}" data-id="${esc(l.id)}">${stages.map((s: string) => `<option value="${s}"${s === l.stage ? ' selected' : ''}>${LABEL[s] ?? s}</option>`).join('')}</select></td></tr>`;
      }).join('') || '<tr><td colspan="6">Aún no hay leads.</td></tr>';
      msg.textContent = '';
    };
    body.addEventListener('change', async (e) => {
      const sel = e.target as HTMLSelectElement;
      if (!sel.dataset.id) return;
      const r = await fetch(`${api}/v1/admin/leads/${sel.dataset.id}`, { method: 'PATCH', headers: { ...h, 'content-type': 'application/json' }, body: JSON.stringify({ stage: sel.value }) });
      msg.textContent = r.ok ? 'Etapa guardada.' : 'No se pudo guardar la etapa.';
    });
    let t: number | undefined;
    qIn.addEventListener('input', () => { clearTimeout(t); t = setTimeout(load, 300) as unknown as number; });
    live.querySelector('[data-live-out]')!.addEventListener('click', () => { sessionStorage.removeItem('lp365-admin'); location.href = '/admin/login/'; });
    load().catch(() => (msg.textContent = 'No se pudo conectar con la API.'));
  }
</script>
</Admin>
