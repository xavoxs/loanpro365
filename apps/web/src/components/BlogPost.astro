---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { COMPANY, ROUTES, t, toolPath, TOOL_SLUGS, type Locale, type ToolKey } from '../i18n';
import { SERIES } from '../i18n/series';
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const locale = post.data.lang as Locale;
const d = t(locale);
const es = locale === 'es';
const href = (p: CollectionEntry<'blog'>) => `${ROUTES.blog[p.data.lang as Locale]}${p.data.slug}/`;

const twin = (await getCollection('blog', (p) => p.data.translationKey === post.data.translationKey && p.data.lang !== locale))[0];
const otherLang: Locale = es ? 'en' : 'es';
const alternates = { [locale]: href(post), [otherLang]: twin ? href(twin) : ROUTES.blog[otherLang] } as Record<Locale, string>;

// Ruta de aprendizaje: lista ordenada de la serie, paso actual y siguiente.
const series = post.data.series
  ? (await getCollection('blog', (p) => p.data.lang === locale && p.data.series === post.data.series)).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  : [];
const meta = post.data.series ? SERIES[locale][post.data.series] : undefined;
const idx = series.findIndex((p) => p.id === post.id);
const next = idx >= 0 ? series[idx + 1] : undefined;
const tool = post.data.tool && post.data.tool in TOOL_SLUGS ? (post.data.tool as ToolKey) : undefined;
const stepLabel = (n: number) => (es ? `Paso ${n} de ${series.length}` : `Step ${n} of ${series.length}`);
// La acción final depende de la ruta: precalificación (vivienda/refinanciación) o asesor (comercial).
const actionHref = meta?.action === 'advisor' ? COMPANY.whatsappHref : ROUTES.prequal[locale];
const actionLabel = meta?.actionLabel ?? d.cta.prequal;
const { Content } = await render(post);
---
<Base locale={locale} title={`${post.data.title} · LoanPro365`} description={post.data.description} alternates={alternates}>
  <p class="small crumb">
    <a href={ROUTES.blog[locale]}>Blog</a>
    {meta && <span> · {meta.name} · {stepLabel(idx + 1)}</span>}
  </p>
  <article class="prose">
    <h1>{post.data.title}</h1>
    <p class="lead">{post.data.description}</p>
    <Content />
  </article>

  {tool && (
    <aside class="post-cta" aria-label={es ? 'Ponlo en práctica' : 'Put it into practice'}>
      <div>
        <h2>{es ? 'Ponlo en práctica' : 'Put it into practice'}</h2>
        <p>{d.tools[tool].desc}</p>
      </div>
      <div class="post-cta-actions">
        <a class="btn ghost" href={toolPath(tool, locale)}>{d.tools[tool].name}</a>
        <a class="btn" href={actionHref} rel={meta?.action === 'advisor' ? 'noopener' : undefined}>{actionLabel}</a>
      </div>
    </aside>
  )}

  {meta && series.length > 0 && (
    <nav class="learn-path" aria-label={meta.name}>
      {next ? (
        <a class="path-next" href={href(next)}>
          <span class="small">{es ? 'Siguiente' : 'Next'} · {stepLabel(idx + 2)}</span>
          <strong>{next.data.title}</strong>
          <Icon name="arrow-right" size={22} />
        </a>
      ) : (
        <div class="path-done">
          <strong>{meta.doneTitle}</strong>
          <p>{meta.doneText}</p>
          <a class="btn" href={actionHref} rel={meta.action === 'advisor' ? 'noopener' : undefined}>{actionLabel}<Icon name="arrow-right" size={20} /></a>
        </div>
      )}
      <ol class="path-steps">
        {series.map((p, i) => (
          <li class={i === idx ? 'current' : i < idx ? 'done' : ''}>
            <a href={href(p)} aria-current={i === idx ? 'page' : undefined}><span class="n">{i + 1}</span>{p.data.title}</a>
          </li>
        ))}
      </ol>
    </nav>
  )}

  <p class="small post-note">{es ? 'Información general con fines educativos; no es asesoría legal ni fiscal ni una oferta de crédito. Requisitos, tasas y programas cambian y dependen de cada prestamista.' : 'General information for educational purposes, not legal or tax advice or an offer of credit. Requirements, rates and programs change and vary by lender.'}</p>
</Base>
