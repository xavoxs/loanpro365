---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { COMPANY, ROUTES, type Locale } from '../i18n';
import { HOME } from '../i18n/home';
import { LANDING } from '../i18n/landing';
import { SERIES, SERIES_KEYS } from '../i18n/series';

interface Props { locale: Locale }
const { locale } = Astro.props;
const h = HOME[locale];
const L = LANDING[locale];
const E = L.hero.est;
const es = locale === 'es';

// Aprende: el primer paso de cada ruta del blog.
const allPosts = await getCollection('blog', (p) => p.data.lang === locale);
const paths = SERIES_KEYS.map((key) => allPosts.filter((p) => p.data.series === key).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))[0])
  .filter((p): p is (typeof allPosts)[number] => Boolean(p));
---
<Base locale={locale} title={es ? 'LoanPro365 Mortgages · Descubre hasta qué precio de casa puedes comprar en Florida' : 'LoanPro365 Mortgages · See how much home you can afford in Florida'} description={L.hero.sub} alternates={ROUTES.home} full>
  <!-- 1. Hero: la promesa y su respuesta en la misma pantalla -->
  <section class="hero hero-video hero-a" aria-labelledby="hero-title">
    <video class="hero-bg" autoplay muted loop playsinline preload="metadata" poster="/video/hero-poster.jpg" aria-hidden="true" data-hero-video>
      <source src="/video/hero-720.mp4" type="video/mp4" media="(max-width: 767px)" />
      <source src="/video/hero-1280.mp4" type="video/mp4" />
    </video>
    <div class="hero-shade" aria-hidden="true"></div>
    <button class="video-toggle" type="button" data-video-toggle aria-pressed="false">
      <span class="visually-hidden">{es ? 'Pausar o reproducir el video de fondo' : 'Pause or play the background video'}</span>
      <span class="ico-pause"><Icon name="pause" size={16} /></span><span class="ico-play"><Icon name="play" size={16} /></span>
    </button>
    <div class="wrap hero-a-inner">
      <div class="hero-a-copy">
        <h1 id="hero-title">{L.hero.h1}</h1>
        <p class="lead">{L.hero.sub}</p>
        <nav class="hero-a-chips" aria-label={L.hero.chipsLabel}>
          <span class="chips-label">{L.hero.chipsLabel}</span>
          {L.hero.chips.map((c) => <a href={ROUTES[c.key][locale]}><Icon name={c.icon} size={18} />{c.t}</a>)}
        </nav>
      </div>

      <form class="estimator budget" id="estimator" data-locale={locale} data-prequal novalidate>
        <h2>{E.title}</h2>
        <div class="est-fields">
          <label>{E.income}<span class="money"><input name="income" type="number" inputmode="numeric" min="0" step="100" placeholder="7,000" required /></span></label>
          <label>{E.down}<span class="money"><input name="down" type="number" inputmode="numeric" min="0" step="1000" placeholder="25,000" /></span></label>
        </div>
        <button class="btn block" type="submit" data-calc>{E.calc}</button>
        <p class="error" role="alert" hidden data-empty>{E.empty}</p>
        <div class="est-out" aria-live="polite" hidden data-out>
          <span class="label">{E.result}</span>
          <span class="value" data-range>—</span>
          <a class="btn block" href={ROUTES.prequal[locale]} data-est-cta>{E.next}<Icon name="arrow-right" size={20} /></a>
        </div>
        <p class="est-note">{E.note}</p>
      </form>
    </div>
  </section>

  <!-- 2. ¿Qué quieres lograr? -->
  <section class="band" aria-labelledby="goals">
    <div class="wrap">
      <h2 id="goals" class="section-title">{L.goals.h}</h2>
      <p class="section-sub">{L.goals.d}</p>
      <div class="goal-cards">
        {L.goals.items.map((g) => (
          <a class="goal-card" href={ROUTES[g.key][locale]}>
            <span class="ico"><Icon name={g.icon} size={22} /></span>
            <h3>{g.t}</h3>
            <p>{g.d}</p>
            <span class="go" aria-hidden="true"><Icon name="arrow-right" size={20} /></span>
            <span class="visually-hidden">{g.cta}</span>
          </a>
        ))}
      </div>
      <p class="also">{L.goals.also} {L.goals.alsoLinks.map((l, i) => <><a href={ROUTES[l.key][locale]}>{l.t}</a>{i < L.goals.alsoLinks.length - 1 && ' · '}</>)} · <a href={ROUTES.tools[locale]}>{L.calcAll}</a></p>
    </div>
  </section>

  <!-- 3. Lo que ganas -->
  <section class="band alt" aria-labelledby="why">
    <div class="wrap">
      <h2 id="why" class="section-title">{L.why.h}</h2>
      <ul class="why3">
        {L.why.items.map((w) => (
          <li>
            {w.n.startsWith('icon:') ? <span class="why-ico"><Icon name={w.n.slice(5)} size={34} /></span> : <strong>{w.n}</strong>}
            <h3>{w.t}</h3>
            <p>{w.d}</p>
          </li>
        ))}
      </ul>
      <div class="why-foot">
        <a class="btn ghost" href={ROUTES.about[locale]}>{L.why.cta}</a>
        <p class="small">{L.why.note}</p>
      </div>
    </div>
  </section>

  <!-- 4. Entiende el proceso -->
  {paths.length > 0 && (
    <section class="band" aria-labelledby="learn">
      <div class="wrap">
        <h2 id="learn" class="section-title">{L.learn.h}</h2>
        <p class="section-sub">{L.learn.d}</p>
        <div class="blog-cards">
          {paths.map((p) => (
            <a class="blog-card" href={`${ROUTES.blog[locale]}${p.data.slug}/`}>
              {p.data.series && <span class="tag">{SERIES[locale][p.data.series].name}</span>}
              <h3>{p.data.title}</h3>
              <span class="more">{L.learn.read}<Icon name="arrow-right" size={16} /></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 5. Preguntas frecuentes -->
  <section class="band alt" aria-labelledby="faq">
    <div class="wrap faq-narrow">
      <h2 id="faq" class="section-title">{L.faqTitle}</h2>
      <div class="faq">
        {h.faq.items.map((f) => (
          <details>
            <summary>{f.q}<Icon name="chevron-down" size={20} /></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Cierre -->
  <section class="final" aria-labelledby="final">
    <div class="wrap">
      <h2 id="final">{L.final.h}</h2>
      <p>{L.final.d}</p>
      <div class="final-actions">
        <a class="btn" href={ROUTES.prequal[locale]}>{L.final.cta}<Icon name="arrow-right" size={20} /></a>
        <a class="btn ghost-light" href={COMPANY.whatsappHref} rel="noopener">{L.final.talk}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { affordability } from '@loanpro365/calculators';

  // Video de fondo: respeta «reducir movimiento» y el ahorro de datos, y se puede pausar.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-video-toggle]');
  if (video && toggle) {
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || conn?.saveData) {
      video.removeAttribute('autoplay');
      video.pause();
      toggle.setAttribute('aria-pressed', 'true');
    }
    toggle.addEventListener('click', () => {
      if (video.paused) { video.play().catch(() => {}); toggle.setAttribute('aria-pressed', 'false'); }
      else { video.pause(); toggle.setAttribute('aria-pressed', 'true'); }
    });
  }

  // Estimador del hero: «Calcular mi presupuesto» muestra el rango; después se actualiza en vivo.
  const form = document.getElementById('estimator') as HTMLFormElement | null;
  if (form) {
    const outBox = form.querySelector<HTMLElement>('[data-out]')!;
    const out = form.querySelector<HTMLElement>('[data-range]')!;
    const empty = form.querySelector<HTMLElement>('[data-empty]')!;
    const cta = form.querySelector<HTMLAnchorElement>('[data-est-cta]')!;
    const incomeEl = form.elements.namedItem('income') as HTMLInputElement;
    const downEl = form.elements.namedItem('down') as HTMLInputElement;
    const fmt = new Intl.NumberFormat(form.dataset.locale === 'es' ? 'es-US' : 'en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let shown = [0, 0];
    let raf = 0;
    let started = false;

    const compute = () => {
      const income = Number(incomeEl.value) || 0;
      const down = Number(downEl.value) || 0;
      const max = affordability({ grossMonthlyIncome: income, monthlyDebts: 0, downPayment: down, annualRatePct: 6.5, years: 30, housingCostsPctOfPrice: 3 }).maxPrice;
      return { low: Math.floor((max * 0.85) / 1000) * 1000, max, income, down };
    };
    // Interacción distintiva: el rango cuenta de un valor al otro.
    const animateTo = (target: [number, number]) => {
      cancelAnimationFrame(raf);
      const from = [...shown];
      const start = performance.now();
      const dur = reduce ? 0 : 450;
      out.classList.add('tick');
      const step = (now: number) => {
        const k = dur === 0 ? 1 : Math.min(1, (now - start) / dur);
        const e = 1 - Math.pow(1 - k, 4);
        shown = [from[0] + (target[0] - from[0]) * e, from[1] + (target[1] - from[1]) * e];
        out.textContent = `${fmt.format(shown[0])} – ${fmt.format(shown[1])}`;
        if (k < 1) raf = requestAnimationFrame(step);
        else out.classList.remove('tick');
      };
      raf = requestAnimationFrame(step);
    };
    const show = () => {
      const r = compute();
      if (r.income <= 0) { empty.hidden = false; incomeEl.setAttribute('aria-invalid', 'true'); incomeEl.focus(); return; }
      empty.hidden = true;
      incomeEl.removeAttribute('aria-invalid');
      outBox.hidden = false;
      started = true;
      animateTo([r.low, r.max]);
    };
    form.addEventListener('submit', (e) => { e.preventDefault(); show(); });
    form.addEventListener('input', () => { if (started) show(); });
    // Lleva los datos a la precalificación (solo en esta pestaña, nunca en la URL).
    cta.addEventListener('click', () => {
      const r = compute();
      try { sessionStorage.setItem('lp365-est', JSON.stringify({ income: r.income, down: r.down })); } catch {}
    });
  }
</script>
