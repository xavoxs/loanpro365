---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { COMPANY, ROUTES, type Locale } from '../i18n';
import { HOME } from '../i18n/home';
import { V4COPY } from '../i18n/v4';
import { SERIES, SERIES_KEYS } from '../i18n/series';

interface Props { locale: Locale }
const { locale } = Astro.props;
const h = HOME[locale];
const C = V4COPY[locale];
const B = C.bento;
const es = locale === 'es';

const allPosts = await getCollection('blog', (p) => p.data.lang === locale);
const paths = SERIES_KEYS.map((key) => allPosts.filter((p) => p.data.series === key).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))[0])
  .filter((p): p is (typeof allPosts)[number] => Boolean(p));
const pathIcons = ['house', 'refresh-cw', 'building-2'];
---
<Base locale={locale} title={es ? 'LoanPro365 Mortgages · Calcula cuánto puedes pagar por tu casa en Florida' : 'LoanPro365 Mortgages · Know what you can pay for your home in Florida'} description={C.sub} alternates={ROUTES.home} full>
  <!-- Hero cinematográfico: titular centrado y un solo campo -->
  <section class="v4-hero" aria-labelledby="hero-title">
    <video class="v4-hero-bg" autoplay muted loop playsinline preload="metadata" poster="/video/hero-poster.jpg" aria-hidden="true" data-hero-video>
      <source src="/video/hero-720.mp4" type="video/mp4" media="(max-width: 767px)" />
      <source src="/video/hero-1280.mp4" type="video/mp4" />
    </video>
    <div class="v4-hero-shade" aria-hidden="true"></div>
    <button class="video-toggle" type="button" data-video-toggle aria-pressed="false">
      <span class="visually-hidden">{es ? 'Pausar o reproducir el video de fondo' : 'Pause or play the background video'}</span>
      <span class="ico-pause"><Icon name="pause" size={16} /></span><span class="ico-play"><Icon name="play" size={16} /></span>
    </button>

    <div class="wrap v4-hero-inner">
      <h1 id="hero-title" class="reveal">{C.h1}</h1>
      <p class="v4-sub reveal">{C.sub}</p>

      <form class="v4-bar reveal" id="estimator" data-locale={locale} data-prequal novalidate>
        <label class="field"><span>{C.bar.income}</span><span class="money"><input name="income" type="number" inputmode="numeric" min="0" step="100" placeholder="7,000" required /></span></label>
        <label class="field"><span>{C.bar.down}</span><span class="money"><input name="down" type="number" inputmode="numeric" min="0" step="1000" placeholder="25,000" /></span></label>
        <button class="btn" type="submit" data-calc>{C.bar.calc}<Icon name="arrow-right" size={18} /></button>
      </form>
      <p class="v4-error" role="alert" hidden data-empty>{C.empty}</p>

      <div class="v4-result" aria-live="polite" hidden data-out>
        <span class="label">{C.result}</span>
        <span class="value" data-range>—</span>
        <div class="pay" data-pay>
          <div class="pay-head"><span>{C.pay.h}</span><strong data-pay-total>—</strong></div>
          <div class="pay-bar" aria-hidden="true"><span class="seg-pi" data-seg-pi></span><span class="seg-ti" data-seg-ti></span></div>
          <ul class="pay-legend">
            <li><i class="dot dot-pi"></i>{C.pay.pi}<b data-pay-pi>—</b></li>
            <li><i class="dot dot-ti"></i>{C.pay.ti}<b data-pay-ti>—</b></li>
          </ul>
        </div>
        <a class="btn" href={ROUTES.prequal[locale]} data-est-cta>{C.next}<Icon name="arrow-right" size={18} /></a>
        <p class="note">{C.note}</p>
      </div>

      <ul class="v4-trust reveal">
        {C.trust.map((t) => <li><Icon name="check" size={16} />{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- Bento: tipos de préstamo + pruebas en una sola rejilla -->
  <section class="v4-section" aria-labelledby="bento">
    <div class="wrap">
      <h2 id="bento" class="v4-h2 reveal">{B.h}</h2>
      <div class="bento">
        <a class="pcard pcard-buy reveal" href={ROUTES[B.buy.key][locale]}>
          <img src="/img/buy-family.jpg" alt="" width="1200" height="800" loading="lazy" decoding="async" />
          <span class="pbody"><strong>{B.buy.t}</strong><span>{B.buy.d}</span></span>
          <span class="tile-go" aria-hidden="true"><Icon name="arrow-up-right" size={20} /></span>
        </a>
        <a class="pcard pcard-refi reveal" href={ROUTES[B.refi.key][locale]}>
          <img src="/img/refi-house.jpg" alt="" width="1000" height="667" loading="lazy" decoding="async" />
          <span class="pbody"><strong>{B.refi.t}</strong><span>{B.refi.d}</span></span>
          <span class="tile-go" aria-hidden="true"><Icon name="arrow-up-right" size={20} /></span>
        </a>
        <div class="tile tile-stat reveal"><strong>{B.stat1.n}</strong><span>{B.stat1.d}</span></div>
        <div class="tile tile-stat tile-stat-alt reveal"><strong>{B.stat2.n}</strong><span>{B.stat2.d}</span></div>
        <a class="pcard pcard-biz reveal" href={ROUTES[B.biz.key][locale]}>
          <img src="/img/biz-miami.jpg" alt="" width="900" height="1350" loading="lazy" decoding="async" />
          <span class="pbody"><strong>{B.biz.t}</strong><span>{B.biz.d}</span></span>
          <span class="tile-go" aria-hidden="true"><Icon name="arrow-up-right" size={20} /></span>
        </a>
        <div class="tile tile-dark reveal">
          <span class="tile-ico"><Icon name="scale" size={22} /></span>
          <span class="tile-body"><strong>{B.lenders.t}</strong><span>{B.lenders.d}</span></span>
        </div>
      </div>
      <p class="v4-note">{B.note}</p>
    </div>
  </section>

  <!-- Tres pasos -->
  <section class="v4-section v4-tint" aria-labelledby="steps">
    <div class="wrap">
      <h2 id="steps" class="v4-h2 reveal">{C.steps.h}</h2>
      <ol class="v4-steps">
        {C.steps.items.map((s, i) => <li class="reveal"><span class="num">{i + 1}</span><h3>{s.t}</h3><p>{s.d}</p></li>)}
      </ol>
      <p class="v4-center reveal"><a class="btn" href={ROUTES.prequal[locale]}>{C.steps.cta}<Icon name="arrow-right" size={18} /></a></p>
    </div>
  </section>

  <!-- Aprende -->
  {paths.length > 0 && (
    <section class="v4-section" aria-labelledby="learn">
      <div class="wrap">
        <div class="v4-row-head reveal">
          <h2 id="learn" class="v4-h2">{C.learn.h}</h2>
          <a class="link-arrow" href={ROUTES.blog[locale]}>{C.learn.all}<Icon name="arrow-right" size={18} /></a>
        </div>
        <div class="v4-cards">
          {paths.map((p, i) => (
            <a class="v4-card reveal" href={`${ROUTES.blog[locale]}${p.data.slug}/`}>
              <span class="tile-ico"><Icon name={pathIcons[i] ?? 'book-open'} size={22} /></span>
              {p.data.series && <span class="tag">{SERIES[locale][p.data.series].name}</span>}
              <strong>{p.data.title}</strong>
              <span class="tile-go" aria-hidden="true"><Icon name="arrow-up-right" size={18} /></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Preguntas -->
  <section class="v4-section v4-tint" aria-labelledby="faq">
    <div class="wrap v4-faq">
      <h2 id="faq" class="v4-h2 reveal">{C.faq}</h2>
      <div class="faq">
        {h.faq.items.map((f) => (
          <details>
            <summary>{f.q}<Icon name="chevron-down" size={20} /></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Cierre -->
  <section class="v4-final" aria-labelledby="final">
    <div class="wrap">
      <h2 id="final" class="reveal">{C.final.h}</h2>
      <p class="reveal">{C.final.d}</p>
      <div class="v4-final-actions reveal">
        <a class="btn btn-light" href={ROUTES.prequal[locale]}>{C.final.cta}<Icon name="arrow-right" size={18} /></a>
        <a class="btn ghost-light" href={COMPANY.whatsappHref} rel="noopener">{C.final.talk}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { affordability, monthlyPayment } from '@loanpro365/calculators';

  // Aparición suave al hacer scroll (desactivada con «reducir movimiento»).
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = document.querySelectorAll<HTMLElement>('.reveal');
  if (!reduce && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js-reveal');
    const io = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
    items.forEach((el) => io.observe(el));
  }

  // Video de fondo: respeta «reducir movimiento» y el ahorro de datos, y se puede pausar.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-video-toggle]');
  if (video && toggle) {
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    if (reduce || conn?.saveData) { video.removeAttribute('autoplay'); video.pause(); toggle.setAttribute('aria-pressed', 'true'); }
    toggle.addEventListener('click', () => {
      if (video.paused) { video.play().catch(() => {}); toggle.setAttribute('aria-pressed', 'false'); }
      else { video.pause(); toggle.setAttribute('aria-pressed', 'true'); }
    });
  }

  // Barra de cálculo: «Calcular» muestra el rango; después se actualiza en vivo.
  const form = document.getElementById('estimator') as HTMLFormElement | null;
  const outBox = document.querySelector<HTMLElement>('[data-out]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  if (form && outBox && empty) {
    const out = outBox.querySelector<HTMLElement>('[data-range]')!;
    const cta = outBox.querySelector<HTMLAnchorElement>('[data-est-cta]')!;
    const incomeEl = form.elements.namedItem('income') as HTMLInputElement;
    const downEl = form.elements.namedItem('down') as HTMLInputElement;
    const fmt = new Intl.NumberFormat(form.dataset.locale === 'es' ? 'es-US' : 'en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
    let shown = [0, 0];
    let raf = 0;
    let started = false;
    const compute = () => {
      const income = Number(incomeEl.value) || 0;
      const down = Number(downEl.value) || 0;
      const max = affordability({ grossMonthlyIncome: income, monthlyDebts: 0, downPayment: down, annualRatePct: 6.5, years: 30, housingCostsPctOfPrice: 3 }).maxPrice;
      return { low: Math.floor((max * 0.85) / 1000) * 1000, max, income, down };
    };
    // Interacción distintiva: el rango cuenta de un valor al otro.
    const animateTo = (target: [number, number]) => {
      cancelAnimationFrame(raf);
      const from = [...shown];
      const start = performance.now();
      const dur = reduce ? 0 : 500;
      const step = (now: number) => {
        const k = dur === 0 ? 1 : Math.min(1, (now - start) / dur);
        const e = 1 - Math.pow(1 - k, 4);
        shown = [from[0] + (target[0] - from[0]) * e, from[1] + (target[1] - from[1]) * e];
        out.textContent = `${fmt.format(shown[0])} – ${fmt.format(shown[1])}`;
        if (k < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };
    const show = () => {
      const r = compute();
      if (r.income <= 0) { empty.hidden = false; incomeEl.setAttribute('aria-invalid', 'true'); incomeEl.focus(); return; }
      empty.hidden = true;
      incomeEl.removeAttribute('aria-invalid');
      outBox.hidden = false;
      started = true;
      animateTo([r.low, r.max]);
      // Desglose del pago en el tope del rango: capital e interés vs. impuestos y seguro (3% del precio al año).
      const p = monthlyPayment({ price: r.max, downPayment: Math.min(r.down, r.max), annualRatePct: 6.5, years: 30, propertyTaxYearly: r.max * 0.03, insuranceYearly: 0 });
      const ti = p.tax;
      const total = p.principalInterest + ti;
      const q = (sel: string) => outBox.querySelector<HTMLElement>(sel)!;
      q('[data-pay-total]').textContent = `${fmt.format(total)}/${form.dataset.locale === 'es' ? 'mes' : 'mo'}`;
      q('[data-pay-pi]').textContent = fmt.format(p.principalInterest);
      q('[data-pay-ti]').textContent = fmt.format(ti);
      const piPct = total > 0 ? (p.principalInterest / total) * 100 : 0;
      q('[data-seg-pi]').style.flexBasis = `${piPct}%`;
      q('[data-seg-ti]').style.flexBasis = `${100 - piPct}%`;
    };
    form.addEventListener('submit', (e) => { e.preventDefault(); show(); });
    form.addEventListener('input', () => { if (started) show(); });
    cta.addEventListener('click', () => {
      const r = compute();
      try { sessionStorage.setItem('lp365-est', JSON.stringify({ income: r.income, down: r.down })); } catch {}
    });
  }
</script>
