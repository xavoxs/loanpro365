---
/** Íconos Lucide (trazo 2px) incrustados como SVG en el build. Decorativos salvo que se pase `label`. */
import fs from 'node:fs';
import path from 'node:path';

interface Props { name: string; size?: number; label?: string; class?: string }
const { name, size = 20, label, class: cls } = Astro.props;

const candidates = [
  path.resolve(process.cwd(), 'node_modules/lucide-static/icons'),
  path.resolve(process.cwd(), '../../node_modules/lucide-static/icons'),
];
const dir = candidates.find((d) => fs.existsSync(d));
if (!dir) throw new Error('lucide-static not installed');
const svg = fs
  .readFileSync(path.join(dir, `${name}.svg`), 'utf8')
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/\s(width|height)="\d+"/g, '')
  .replace('<svg', `<svg width="${size}" height="${size}" class="icon ${cls ?? ''}" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"'}`);
---
<Fragment set:html={svg} />
