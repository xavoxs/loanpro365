---
import Base from '../layouts/Base.astro';
import { ROUTES, TOOL_SLUGS, t, toolPath, type Locale, type ToolKey } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
---
<Base locale={locale} title={`${d.toolsTitle} · LoanPro365`} description={d.toolsTitle} alternates={ROUTES.tools}>
  <h1>{d.toolsTitle}</h1>
  <div class="grid">
    {(Object.keys(TOOL_SLUGS) as ToolKey[]).map((k) => (
      <a class="card" href={toolPath(k, locale)}><h2 class="h3">{d.tools[k].name}</h2><p>{d.tools[k].desc}</p></a>
    ))}
  </div>
  <p class="small">{d.disclaimer}</p>
</Base>
